# Render Postgres connection string (Render provides this once the
# database is provisioned — Dashboard > your Postgres instance > Connect).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# The deployed Vercel frontend URL. Use http://localhost:3000 for local dev.
FRONTEND_ORIGIN="http://localhost:3000"

# Signs and verifies the admin session JWT (Phase 3 on).
JWT_SECRET="replace-with-a-long-random-string"

# Only read by prisma/seedAdmin.js, not by the running server — used to
# create/reset the single admin login. See that script's header comment.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-real-password"

PORT=4000

# Cloudinary account (free tier is fine) — Dashboard > Account Details.
# Used by POST /api/admin/upload to host listing photos.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
