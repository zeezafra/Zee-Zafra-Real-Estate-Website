# Render Postgres connection string (Render provides this once the
# database is provisioned — Dashboard > your Postgres instance > Connect).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# The deployed Vercel frontend URL. Comma-separate more than one (e.g. a
# custom domain plus its www subdomain, or a Vercel preview alias) — each
# is added to an explicit allow-list, never a wildcard. Use
# http://localhost:3000 for local dev.
FRONTEND_ORIGIN="http://localhost:3000"

# Signs and verifies the admin session JWT (Phase 3 on).
JWT_SECRET="replace-with-a-long-random-string"

# Only read by prisma/seedAdmin.js, not by the running server — used to
# create/reset the single admin login. See that script's header comment.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-real-password"

PORT=4000

# Cloudinary account (free tier is fine) — Dashboard > Account Details.
# Used by POST /api/admin/upload to host listing photos.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Phase 20 — Cloudflare Turnstile (free, no usage cap). Create a widget at
# dash.cloudflare.com > Turnstile, add your Vercel domain (and
# "localhost" for local dev) as allowed hostnames, then put the SECRET key
# here and the SITE key in the frontend's NEXT_PUBLIC_TURNSTILE_SITE_KEY.
# Leave this unset and CAPTCHA verification is skipped entirely — the
# inquiry form still works, still rate-limited and still spam-filtered.
TURNSTILE_SECRET_KEY=""

# Resend — emails Zee whenever a real (non-spam) inquiry comes in.
# Optional: leave RESEND_API_KEY empty and everything still works, the
# email is just skipped (a warning is logged at startup). Create the key at
# resend.com > API Keys ("Sending access" is enough).
RESEND_API_KEY=""
# Where the notification goes. Falls back to ADMIN_EMAIL when unset, so
# usually you only need the key. Comma-separate for more than one address.
# While sending from Resend's sandbox address (below), this must be the
# email address your Resend account was created with — Resend refuses to
# deliver from the sandbox sender to anyone else.
INQUIRY_NOTIFY_TO=""
# The "From" address. Unset = Resend's sandbox sender
# (onboarding@resend.dev), which works immediately with no setup. To send
# from your own address, verify a domain in Resend first, then set e.g.
# "Zee Zafra Properties <inquiries@yourdomain.com>".
RESEND_FROM_EMAIL=""

# ---- Phase 26 ----
# Visitor auto-reply ("thanks, I'll reply within X"). On by default; needs
# Resend to be sending from a VERIFIED DOMAIN to reach visitors (the sandbox
# sender only delivers to your own address).
AUTO_REPLY_ENABLED="true"
AUTO_REPLY_RESPONSE_TIME="within 24 hours"
# Where visitor replies land. Defaults to the first INQUIRY_NOTIFY_TO/ADMIN_EMAIL address.
REPLY_TO_EMAIL=""
AGENT_NAME="Zee Zafra"

# Daily digest trigger. Unset = the endpoint is disabled. Set to a long random
# string, and put the same value in the GitHub Actions secret CRON_SECRET.
CRON_SECRET=""
