NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional in dev. Set this on Vercel once Zee has a domain (custom domain,
# or the assigned *.vercel.app one) — powers metadataBase, the OG image,
# sitemap.xml, and robots.txt. Falls back to Vercel's own VERCEL_URL env var
# (auto-set on Vercel) if unset, then to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 20 — Cloudflare Turnstile SITE key (the public half; the secret
# half goes in the backend's TURNSTILE_SECRET_KEY). Create the widget at
# dash.cloudflare.com > Turnstile and allow both your Vercel domain and
# "localhost". Leave unset and the CAPTCHA simply doesn't render — the
# forms still work, and the backend still rate-limits and spam-filters.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
